{
  "name": "nova-sport-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST educacional da NOVA SPORT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node src/config/migrate.js up",
    "db:migrate:undo": "node src/config/migrate.js down",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.0",
    "sequelize": "^6.37.7",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    }
  }
}
